{
  "expo": {
    "name": "WombCare",
    "slug": "wombcare",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./src/assets/images/icon.png",
    "scheme": "wombcare",
    "userInterfaceStyle": "light",

    "android": {
      "package": "com.wombcare.app",
      "versionCode": 2,
      "orientation": "portrait",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#FFF0F6"
      },
      "predictiveBackGestureEnabled": false
    },

    "ios": {
      "bundleIdentifier": "com.wombcare.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "web": {
      "output": "static",
      "favicon": "./src/assets/images/icon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF0F6"
        }
      ],

      "expo-font",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d4e360e-c766-43ee-a938-a57dcd43a9fb"
      }
    }
  }
}